config_version=5

[application]

config/name="Lukomorye: Ashes of Tales"
config/name_localized={
"ru": "Лукоморье: Пепел Сказаний"
}
config/description="Уютная, мрачная 2D RPG о хозяйстве, памяти и мире, который слишком долго повторяет одну и ту же сказку."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
TimeManager="*res://scripts/autoload/TimeManager.gd"
MoralityManager="*res://scripts/autoload/MoralityManager.gd"
BookManager="*res://scripts/autoload/BookManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

